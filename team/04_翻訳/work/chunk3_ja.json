 "s0386": {
  "ja": "ウォーカー",
  "where": "敵"
 },
 "s0387": {
  "ja": "霧に憑かれた市民。動きは遅いが、数で押してくる。",
  "where": "敵"
 },
 "s0388": {
  "ja": "ランナー",
  "where": "敵"
 },
 "s0389": {
  "ja": "陸上部のジャージを着た個体。とにかく速い。優先して倒そう。",
  "where": "敵"
 },
 "s0390": {
  "ja": "スピッター",
  "where": "敵"
 },
 "s0391": {
  "ja": "距離を取って強酸を吐く。足元の酸だまりはジャンプで避ける。",
  "where": "敵"
 },
 "s0392": {
  "ja": "ボマー",
  "where": "敵"
 },
 "s0393": {
  "ja": "体内にガスを溜め込んだ個体。近づくと自爆する。遠くで撃てば周囲のゾンビを巻き込める。",
  "where": "敵"
 },
 "s0394": {
  "ja": "リーパー",
  "where": "敵"
 },
 "s0395": {
  "ja": "壁を蹴って飛びかかってくる。着地の瞬間が狙い目。",
  "where": "敵"
 },
 "s0396": {
  "ja": "アーマード",
  "where": "敵"
 },
 "s0397": {
  "ja": "機動隊員だったもの。正面からの銃弾を{}割軽減する。徹甲弾・爆発・会心が有効。",
  "where": "敵"
 },
 "s0398": {
  "ja": "スクリーマー",
  "where": "敵"
 },
 "s0399": {
  "ja": "金切り声で仲間を呼び、周囲のゾンビを凶暴化させる。最優先目標。",
  "where": "敵"
 },
 "s0400": {
  "ja": "ブルート",
  "where": "敵"
 },
 "s0401": {
  "ja": "巨体の変異個体。ひるまず、殴られると大きく吹き飛ばされる。",
  "where": "敵"
 },
 "s0402": {
  "ja": "ウィーパー",
  "where": "敵"
 },
 "s0403": {
  "ja": "すすり泣きながら早足で迫る女性のゾンビ。ウォーカーより足が速い。",
  "where": "敵"
 },
 "s0404": {
  "ja": "スポアラー",
  "where": "敵"
 },
 "s0405": {
  "ja": "キノコに寄生された男。胞子の塊を投げ、倒れた場所にも毒だまりを残す。",
  "where": "敵"
 },
 "s0406": {
  "ja": "チェインファット",
  "where": "敵"
 },
 "s0407": {
  "ja": "鎖を振り回す巨漢。間合いがとても広い。振りかぶったら離れるか、回避で懐に飛び込め。",
  "where": "敵"
 },
 "s0408": {
  "ja": "ジャガーノート",
  "where": "敵"
 },
 "s0409": {
  "ja": "鎧をまとった斧の巨人。正面からの銃弾を{}割はじく。徹甲弾・爆発・会心、または背後から。",
  "where": "敵"
 },
 "s0410": {
  "ja": "パイロウィッチ",
  "where": "敵"
 },
 "s0411": {
  "ja": "火の玉をまっすぐ撃ってくる魔女。火球はジャンプか回避でかわせる。",
  "where": "敵"
 },
 "s0412": {
  "ja": "マダム・ワルツ",
  "where": "敵"
 },
 "s0413": {
  "ja": "踊り続ける貴婦人のゾンビ。舞うたびに周囲のゾンビの傷が癒える。真っ先に倒したい。",
  "where": "敵"
 },
 "s0414": {
  "ja": "ロットピジョン",
  "where": "敵"
 },
 "s0415": {
  "ja": "腐ったハト。弱いが群れで押し寄せる。SMGやショットガンでまとめて片付けよう。",
  "where": "敵"
 },
 "s0416": {
  "ja": "スカルクロウ",
  "where": "敵"
 },
 "s0417": {
  "ja": "頭が骨になったカラス。距離を取って羽ばたき、飛びかかってくる。",
  "where": "敵"
 },
 "s0418": {
  "ja": "ゾンビウルフ",
  "where": "敵"
 },
 "s0419": {
  "ja": "群れで走り回る狼のゾンビ。とにかく速く、遠くから噛みつきに跳んでくる。",
  "where": "敵"
 },
 "s0420": {
  "ja": "ロットイーグル",
  "where": "敵"
 },
 "s0421": {
  "ja": "巨大な鷲のゾンビ。大きく羽ばたいて長い距離を一気に飛びかかる。",
  "where": "敵"
 },
 "s0422": {
  "ja": "ゾンビベア",
  "where": "敵"
 },
 "s0423": {
  "ja": "矢が刺さったまま歩く熊のゾンビ。体力・攻撃力ともに最大級で、ブルートより足が速い。",
  "where": "敵"
 },
 "s0424": {
  "ja": "教頭だったもの",
  "where": "ボス"
 },
 "s0425": {
  "ja": "霧ヶ丘女子高校 教頭",
  "where": "ボス"
 },
 "s0426": {
  "ja": "「廊下は走るな」が口ぐせだった。今は自分が走ってくる。",
  "where": "ボス"
 },
 "s0427": {
  "ja": "ブッチャー",
  "where": "ボス"
 },
 "s0428": {
  "ja": "さくら通り精肉店 店主",
  "where": "ボス"
 },
 "s0429": {
  "ja": "コロッケをおまけしてくれる優しい店主だった。地面を叩く衝撃波はジャンプで回避。",
  "where": "ボス"
 },
 "s0430": {
  "ja": "終電の車掌",
  "where": "ボス"
 },
 "s0431": {
  "ja": "霧ヶ丘線 最終列車 乗務員",
  "where": "ボス"
 },
 "s0432": {
  "ja": "駆け込み乗車を絶対に許さない。連続で突進してくる。",
  "where": "ボス"
 },
 "s0433": {
  "ja": "ドクター・ネクロ",
  "where": "ボス"
 },
 "s0434": {
  "ja": "市立総合病院 院長",
  "where": "ボス"
 },
 "s0435": {
  "ja": "霧の正体を知りながら隠蔽した男。強酸を雨のように降らせる。",
  "where": "ボス"
 },
 "s0436": {
  "ja": "ペイシェント・ゼロ",
  "where": "ボス"
 },
 "s0437": {
  "ja": "発生炉の心臓 ― 最初の一人",
  "where": "ボス"
 },
 "s0438": {
  "ja": "霧を生み続ける最初の被験者。すべての攻撃を使い、体力が減るほど凶暴になる。",
  "where": "ボス"
 },
 "s0439": {
  "ja": "監視塔の主",
  "where": "ボス"
 },
 "s0440": {
  "ja": "潮見浜 海水浴場 ライフセーバー",
  "where": "ボス"
 },
 "s0441": {
  "ja": "「遊泳区域から出ないでください」。浜の端から端まで一瞬で駆けてくる。",
  "where": "ボス"
 },
 "s0442": {
  "ja": "霧の母",
  "where": "ボス"
 },
 "s0443": {
  "ja": "ヘリオス製薬 第四研究所 所長 潮見サヨコ",
  "where": "ボス"
 },
 "s0444": {
  "ja": "霧の薬を最初に作った研究者。海の霧そのものを纏い、すべての攻撃を使う。",
  "where": "ボス"
 },
 "s0445": {
  "ja": "霧ヶ丘女子高校",
  "where": "章"
 },
 "s0446": {
  "ja": "放課後、世界が終わった",
  "where": "章"
 },
 "s0447": {
  "ja": "さくら通り商店街",
  "where": "章"
 },
 "s0448": {
  "ja": "コロッケの匂いはもうしない",
  "where": "章"
 },
 "s0449": {
  "ja": "地下鉄・霧ヶ丘線",
  "where": "章"
 },
 "s0450": {
  "ja": "終電のあとに来るもの",
  "where": "章"
 },
 "s0451": {
  "ja": "市立総合病院",
  "where": "章"
 },
 "s0452": {
  "ja": "緑の非常灯の下で",
  "where": "章"
