 "s0386": {
  "en": "Walker",
  "zh": "行尸"
 },
 "s0387": {
  "en": "A citizen possessed by the Fog. Slow, but comes in numbers.",
  "zh": "被雾附身的市民。动作迟缓，但数量众多。"
 },
 "s0388": {
  "en": "Runner",
  "zh": "疾跑者"
 },
 "s0389": {
  "en": "Wears a track team tracksuit. Very fast. Take it down first.",
  "zh": "穿着田径队运动服的个体。速度极快，优先击倒它吧。"
 },
 "s0390": {
  "en": "Spitter",
  "zh": "喷吐者"
 },
 "s0391": {
  "en": "Spits strong acid from a distance. Jump over the acid puddles it leaves.",
  "zh": "保持距离喷吐强酸。脚下的酸液池可以跳跃躲开。"
 },
 "s0392": {
  "en": "Bomber",
  "zh": "自爆者"
 },
 "s0393": {
  "en": "Swollen with gas. Explodes when it gets close. Shoot it from afar to catch nearby zombies in the blast.",
  "zh": "体内积满气体的个体。靠近就会自爆。在远处射击可以波及周围的僵尸。"
 },
 "s0394": {
  "en": "Leaper",
  "zh": "跳跃者"
 },
 "s0395": {
  "en": "Kicks off walls to pounce on you. Strike the moment it lands.",
  "zh": "蹬墙扑过来。落地的瞬间就是机会。"
 },
 "s0396": {
  "en": "Armored",
  "zh": "装甲者"
 },
 "s0397": {
  "en": "Once a riot police officer. Cuts frontal gunfire damage by {}0%. AP rounds, explosions and crits work well.",
  "zh": "曾是防暴警察。来自正面的子弹伤害减少{}成。穿甲弹、爆炸、暴击对它有效。"
 },
 "s0398": {
  "en": "Screamer",
  "zh": "尖叫者"
 },
 "s0399": {
  "en": "Its shriek calls for help and sends nearby zombies into a frenzy. Top priority target.",
  "zh": "用尖叫召集同伴，让周围的僵尸狂暴化。最优先目标。"
 },
 "s0400": {
  "en": "Brute",
  "zh": "蛮力者"
 },
 "s0401": {
  "en": "A massive mutant. It never flinches, and its blows send you flying.",
  "zh": "巨大的变异个体。不会硬直，被它打中会被远远击飞。"
 },
 "s0402": {
  "en": "Weeper",
  "zh": "啜泣者"
 },
 "s0403": {
  "en": "A sobbing female zombie that closes in at a brisk pace. Faster than a Walker.",
  "zh": "一边啜泣一边快步逼近的女性僵尸。比行尸更快。"
 },
 "s0404": {
  "en": "Sporer",
  "zh": "孢子人"
 },
 "s0405": {
  "en": "A man infested by fungus. Throws spore clumps and leaves a poison pool where it falls.",
  "zh": "被蘑菇寄生的男人。投掷孢子团，倒下的地方也会留下毒液池。"
 },
 "s0406": {
  "en": "Chainfat",
  "zh": "锁链巨汉"
 },
 "s0407": {
  "en": "A hulk swinging a chain with huge reach. When it winds up, back off or dodge in close.",
  "zh": "挥舞锁链的巨汉，攻击范围极广。它抡起锁链时，要么拉开距离，要么闪避冲进它怀里。"
 },
 "s0408": {
  "en": "Juggernaut",
  "zh": "重甲巨人"
 },
 "s0409": {
  "en": "An armored giant with an axe. Deflects {}0% of frontal gunfire. Use AP rounds, explosions, crits, or hit it from behind.",
  "zh": "身披铠甲、手持巨斧的巨人。能弹开{}成来自正面的子弹。用穿甲弹、爆炸、暴击，或从背后攻击。"
 },
 "s0410": {
  "en": "Pyrowitch",
  "zh": "火焰女巫"
 },
 "s0411": {
  "en": "A witch who fires fireballs straight at you. Jump or dodge to avoid them.",
  "zh": "直线发射火球的女巫。火球可以跳跃或闪避躲开。"
 },
 "s0412": {
  "en": "Madame Waltz",
  "zh": "华尔兹夫人"
 },
 "s0413": {
  "en": "A noblewoman zombie who never stops dancing. Each twirl heals nearby zombies. Take her out first.",
  "zh": "不停起舞的贵妇僵尸。每次舞动都会治愈周围僵尸的伤势。最好第一个解决她。"
 },
 "s0414": {
  "en": "Rot Pigeon",
  "zh": "腐鸽"
 },
 "s0415": {
  "en": "Rotten pigeons. Weak, but they swarm in flocks. Clear them out with an SMG or shotgun.",
  "zh": "腐烂的鸽子。很弱，但会成群涌来。用冲锋枪或霰弹枪一网打尽吧。"
 },
 "s0416": {
  "en": "Skull Crow",
  "zh": "骷髅鸦"
 },
 "s0417": {
  "en": "A crow whose head is bare bone. Hovers at a distance, then dives at you.",
  "zh": "头部化为白骨的乌鸦。在远处振翅，然后猛扑过来。"
 },
 "s0418": {
  "en": "Zombie Wolf",
  "zh": "僵尸狼"
 },
 "s0419": {
  "en": "Zombie wolves that run in packs. Very fast, and they leap to bite from far away.",
  "zh": "成群奔跑的僵尸狼。速度极快，会从远处扑来撕咬。"
 },
 "s0420": {
  "en": "Rot Eagle",
  "zh": "腐鹰"
 },
 "s0421": {
  "en": "A giant zombie eagle. One mighty flap carries it a long way in a single swoop.",
  "zh": "巨大的僵尸鹰。用力振翅，一口气扑出很远的距离。"
 },
 "s0422": {
  "en": "Zombie Bear",
  "zh": "僵尸熊"
 },
 "s0423": {
  "en": "A zombie bear still walking with arrows in it. Top-tier HP and attack, and faster than a Brute.",
  "zh": "身上还插着箭的僵尸熊。体力和攻击力都是顶级，比蛮力者更快。"
 },
 "s0424": {
  "en": "Ex-Vice Principal",
  "zh": "昔日的教导主任"
 },
 "s0425": {
  "en": "Former vice principal, Kirigaoka Girls' High",
  "zh": "雾丘女子高中 教导主任"
 },
 "s0426": {
  "en": "Catchphrase: \"No running in the halls!\" Now it comes running at you.",
  "zh": "口头禅是「走廊上不许奔跑」。现在却自己朝你跑了过来。"
 },
 "s0427": {
  "en": "Butcher",
  "zh": "屠夫"
 },
 "s0428": {
  "en": "Former owner, Sakura St. Butcher Shop",
  "zh": "樱花街肉铺 老板"
 },
 "s0429": {
  "en": "A kind shopkeeper who used to throw in a free croquette. Jump over the shockwaves from its ground slams.",
  "zh": "曾是会多送你一个可乐饼的和善老板。砸地产生的冲击波可以跳跃躲开。"
 },
 "s0430": {
  "en": "Last Train Conductor",
  "zh": "末班车列车员"
 },
 "s0431": {
  "en": "Former crew, Kirigaoka Line last train",
  "zh": "雾丘线 末班列车 乘务员"
 },
 "s0432": {
  "en": "Never lets anyone rush aboard. Charges again and again.",
  "zh": "绝不容许任何人抢上车。会连续冲撞过来。"
 },
 "s0433": {
  "en": "Dr. Necro",
  "zh": "尼克罗博士"
 },
 "s0434": {
  "en": "Former director, City General Hospital",
  "zh": "市立综合医院 院长"
 },
 "s0435": {
  "en": "Knew the truth about the Fog and covered it up. Rains down strong acid.",
  "zh": "明知雾的真相却加以隐瞒的男人。会像下雨一样降下强酸。"
 },
 "s0436": {
  "en": "Patient Zero",
  "zh": "零号病人"
 },
 "s0437": {
  "en": "Heart of the Reactor — The First One",
  "zh": "发生炉之心 ― 最初的那个人"
 },
 "s0438": {
  "en": "The first test subject, still spawning the Fog. Uses every attack and grows wilder as its HP drops.",
  "zh": "不断产生雾的最初实验体。会使用所有攻击，体力越低越狂暴。"
 },
 "s0439": {
  "en": "Lord of the Watchtower",
  "zh": "监视塔之主"
 },
 "s0440": {
  "en": "Former lifeguard, Shiomi Beach",
  "zh": "潮见海滨浴场 救生员"
 },
 "s0441": {
